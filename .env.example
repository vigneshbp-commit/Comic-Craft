# Google Gemini API Key (Get yours at: https://aistudio.google.com/)
GEMINI_API_KEY=

# Hugging Face API Token (Optional, for Serverless Inference API)
HF_API_KEY=

# Application environment (development / production)
APP_ENV=development

# Image Generation Backend:
# Options:
#  - auto: Attempts local diffusers pipeline if GPU/packages installed, else HF API if HF_API_KEY is set, else Comic Canvas Engine (Pillow)
#  - procedural: Uses high-res Comic Canvas Engine with halftone/comic-styling (Fast, zero GPU needed)
#  - hf_api: Uses Hugging Face Serverless Inference API for Stable Diffusion 1.5
#  - local: Uses local StableDiffusionPipeline (runwayml/stable-diffusion-v1-5) via diffusers
IMAGE_GEN_BACKEND=auto

# Default Gemini Models
DEFAULT_MODEL_FLASH=gemini-1.5-flash
DEFAULT_MODEL_PRO=gemini-1.5-pro

# Server Host & Port
HOST=127.0.0.1
PORT=8000
